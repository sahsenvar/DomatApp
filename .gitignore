# Generated by `./gradlew :shared:sync{Debug,Release}SharedXCFramework` and wrapped by
# iosApp/Packages/Shared/Package.swift. Build output, not source.
iosApp/Packages/Shared/*.xcframework/

# Written by the Firebase CLI / MCP server on every run. Local debug output, not source.
firebase-debug*.log

# JVM heap dumps (written on OutOfMemoryError). Can be gigabytes; never source.
*.hprof
